# Copy to `.env` and fill in. All vars use Nuxt's NUXT_ runtimeConfig convention.

# ── Public ─────────────────────────────────────────────────────────────
# Public base URL of the site (used for sign-in links + OG images)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Brevo) ──────────────────────────────────────────────────────
# If both of the below are blank, emails are logged to the console.
#
# Local dev: leave the API key blank and point NUXT_SMTP_URL at Mailpit from
# docker-compose.dev.yml. It catches everything; read it at http://localhost:8025.
# SMTP wins over the API key, so a key left in .env cannot deliver to a real
# inbox by accident. Unset this in production.
NUXT_SMTP_URL=smtp://localhost:1025
NUXT_BREVO_API_KEY=
# Mailpit proves the templates; this proves the Brevo integration. With a real
# key and SANDBOX=true, Brevo validates auth, body shape and sender in full and
# then drops the message — nothing is delivered and nothing is logged in the
# Brevo dashboard. Comment out NUXT_SMTP_URL above to reach this path. Never
# set it in production: it would silently discard every email.
NUXT_BREVO_SANDBOX=false
# Must be a verified Brevo sender. "Name <addr>" form is fine.
NUXT_FROM_EMAIL=Dorean Press <info@doreanpress.org>
# Optional: get a copy of every new pay-it-forward request.
NUXT_PRESS_EMAIL=

# ── Identity challenge ─────────────────────────────────────────────────
# Before asking for a free book, a reader proves they hold a public account, and
# that account is shown on the Give a Book board. This is a one-shot challenge,
# not a login: there are no accounts on this site and nothing to sign out of.
# See docs/verified-requests.md.
#
# Seals the cookie carrying a completed challenge. Any string of 32+ chars;
# rotating it invalidates any proof in flight, which at worst means someone
# re-verifies. Generate:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=

# Each provider is optional — one with no credentials is simply not offered.
# Register the callback URL as <site>/verify/<provider>, e.g.
# http://localhost:3000/verify/x for local dev.
#
# X: developer.x.com → an OAuth 2.0 app with "users.read" (Confidential client).
NUXT_OAUTH_X_CLIENT_ID=
NUXT_OAUTH_X_CLIENT_SECRET=
# Facebook: developers.facebook.com → Facebook Login, "public_profile" + "email".
NUXT_OAUTH_FACEBOOK_CLIENT_ID=
NUXT_OAUTH_FACEBOOK_CLIENT_SECRET=
# LinkedIn: linkedin.com/developers → "Sign In with LinkedIn using OpenID Connect".
NUXT_OAUTH_LINKEDIN_CLIENT_ID=
NUXT_OAUTH_LINKEDIN_CLIENT_SECRET=
# GitHub: github.com/settings/developers → a plain OAuth App, scope "read:user".
# No review queue, and it gives sponsors a profile to open — start here.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# GitLab: gitlab.com/-/profile/applications → scope "read_user" and nothing more.
# The default "api" scope is a write-capable token for a check that reads a page.
NUXT_OAUTH_GITLAB_CLIENT_ID=
NUXT_OAUTH_GITLAB_CLIENT_SECRET=
# Twitch: dev.twitch.tv/console → register an application, "user:read:email".
NUXT_OAUTH_TWITCH_CLIENT_ID=
NUXT_OAUTH_TWITCH_CLIENT_SECRET=
# TikTok: developers.tiktok.com → Login Kit. Note CLIENT_KEY, not CLIENT_ID —
# TikTok's own name for it. The handle and profile link need "user.info.profile"
# approved; until then a TikTok account shows with nothing to click.
NUXT_OAUTH_TIKTOK_CLIENT_KEY=
NUXT_OAUTH_TIKTOK_CLIENT_SECRET=

# All optional, and they are the only way an account gets onto the board: a real
# round trip that proves the account is the reader's, with no stand-in in dev or
# anywhere else. Naming an account for us to read, and simply claiming one, were
# both removed — neither established that the reader was the person asking, which
# is the only thing a sponsor is relying on. See docs/verified-requests.md.
#
# With none of these set the site still takes requests, from readers with a
# Bluesky account: atproto identifies this client by a metadata document served
# from the site rather than by a secret, so Bluesky needs no registration and is
# always offered. It is not a weaker fallback — it is the same sign-in as the
# rest. Set none of the above and Bluesky is simply the only button on the form.

# ── Database (Neon Postgres) ───────────────────────────────────────────
# Production: a Neon database, whose dashboard issues the connection string.
# Set it as DATABASE_URL and leave NEON_LOCAL_PROXY_ENDPOINT unset, so the
# driver talks to the real Neon endpoint. NETLIFY_DATABASE_URL is still read as
# a fallback, for a deployment that has it injected under that name.
#
# Local dev without a cloud account:
#   1. docker compose -f docker-compose.dev.yml up -d
#   2. set both vars below
# DATABASE_URL points the driver at the local Postgres (host port 5433);
# NEON_LOCAL_PROXY_ENDPOINT redirects the Neon serverless HTTP driver to the
# local proxy container (see server/plugins/neon-local.ts).
DATABASE_URL=postgres://dorean:dorean@localhost:5433/dorean
NEON_LOCAL_PROXY_ENDPOINT=http://localhost:4444/sql

# Amazon / Zeffy ministry migration. Keep donations unavailable until the church
# has approved the campaign and these production settings are complete.
# Embed URL (zeffy.com/embed/donation-form/…) shows the form inline on /give.
NUXT_ZEFFY_CAMPAIGN_URL=
NUXT_ZEFFY_CAMPAIGN_ID=
NUXT_ZEFFY_WEBHOOK_SECRET=
NUXT_ZEFFY_API_KEY=
NUXT_ZEFFY_RECOMMENDATION_QUESTION="Dorean Press request code"
# Standalone EasyPost Trackers are usage-billed. Use test keys locally.
NUXT_EASYPOST_API_KEY=
NUXT_EASYPOST_WEBHOOK_SECRET=
# Random bearer token for POST /api/ministry-maintenance (daily + email retries).
NUXT_MAINTENANCE_SECRET=

# US estimate: observed $4.98 printing + $3.59 shipping + $0.84 tax = $9.41.
# Each additional copy remains a provisional $7 including added shipping/tax.
NUXT_GIFT_ESTIMATE_FIRST_COPY_CENTS=941
NUXT_GIFT_ESTIMATE_ADDITIONAL_COPY_CENTS=700
